# NEXUS STUDIO - Variables de entorno (copiar a `.env.local`)

# Correo de contacto principal (hay fallback en el codigo)
CONTACT_EMAIL=hola@nexusstudio.dev
NEXT_PUBLIC_CONTACT_EMAIL=hola@nexusstudio.dev

# Telefono WhatsApp internacional sin "+" (ej. Peru: 51 + celular).
# IMPORTANTE: los botones de WhatsApp se renderizan en el NAVEGADOR, por eso
# se requieren las variables NEXT_PUBLIC_* (se incrustan en el build).
# En Vercel debes definirlas en Project Settings > Environment Variables.
WHATSAPP_PHONE=51900000000
NEXT_PUBLIC_WHATSAPP_PHONE=51900000000

# (Opcional) API key de Resend para notificaciones reales por email desde /api/contact
# https://resend.com
RESEND_API_KEY=

# (Opcional) URL publica del sitio (se usa en metadata)
NEXT_PUBLIC_SITE_URL=https://nexus-studio.vercel.app
